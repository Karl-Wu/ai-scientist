# AI Scientist offline platform configuration.
# Copy to platform.env in the deployment directory and uncomment as needed.
# Missing values use the defaults shown here.

# Private backend API port.
# KADY_PORT=8000
# KADY_HOST=127.0.0.1

# Public frontend port. This is the only port that normally needs firewall access.
# KADY_FRONTEND_PORT=3000
# KADY_FRONTEND_HOST=0.0.0.0

# Optional additional HTTPS frontend listener. A self-signed certificate for
# KADY_PUBLIC_HOST is generated on first start when key/cert paths are omitted.
# KADY_HTTPS_PORT=3001
# KADY_HTTPS_HOST=0.0.0.0
# KADY_TLS_KEY=platform/tls/key.pem
# KADY_TLS_CERT=platform/tls/cert.pem

# Host printed in the startup banner. Leave unset to use KADY_FRONTEND_HOST.
# KADY_PUBLIC_HOST=127.0.0.1

# Browser origins allowed to call the backend through the frontend proxy.
# Leave unset to derive http://<KADY_PUBLIC_HOST>:<KADY_FRONTEND_PORT>.
# KADY_ALLOWED_ORIGINS=http://127.0.0.1:3000,https://kady.example.com

# The offline launcher keeps Python dependency resolution local.
KADY_OFFLINE=1
KADY_REQUIRE_AUTH=0

# Official ADE offline runtime installed by the platform package.
# ADE_HOME=/data/ade
# ADE_PROJECT=/data/ade/workspace
